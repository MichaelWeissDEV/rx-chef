FROM debian:bookworm-slim

ARG RUST_TOOLCHAIN=1.96.1

ENV DEBIAN_FRONTEND=noninteractive \
    PATH=/root/.cargo/bin:/opt/rxchef-docs/bin:${PATH} \
    CARGO_TERM_COLOR=always \
    RUST_BACKTRACE=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential ca-certificates clang cmake curl file git jq libbz2-dev \
        libclang-dev libfontconfig1-dev libfreetype6-dev liblz4-dev liblzma-dev \
        libssl-dev libtesseract-dev libzstd-dev libleptonica-dev llvm-dev \
        pkg-config python3 python3-dev \
        python3-pip python3-venv tesseract-ocr-eng zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
        | sh -s -- -y --profile minimal --default-toolchain "${RUST_TOOLCHAIN}" \
    && rustup component add rustfmt clippy

COPY docs/requirements.txt /tmp/rxchef-docs-requirements.txt
RUN python3 -m venv /opt/rxchef-docs \
    && pip install --no-cache-dir -r /tmp/rxchef-docs-requirements.txt

COPY docker/release-entrypoint.sh /usr/local/bin/rxchef-release-entrypoint
RUN chmod 0755 /usr/local/bin/rxchef-release-entrypoint

WORKDIR /src
ENTRYPOINT ["/usr/local/bin/rxchef-release-entrypoint"]
