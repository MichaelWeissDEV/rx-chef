# syntax=docker/dockerfile:1
ARG BUILDER_IMAGE=rust:1.96.1-bookworm
FROM node:22.20.0-bookworm-slim AS node
FROM ${BUILDER_IMAGE} AS build
RUN apt-get update && apt-get install -y --no-install-recommends clang cmake libssl-dev pkg-config && rm -rf /var/lib/apt/lists/*
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -sf ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm
WORKDIR /src
COPY . .
ENV CARGO_INCREMENTAL=0 CARGO_HOME=/usr/local/cargo
RUN --mount=type=cache,target=/usr/local/cargo/registry --mount=type=cache,target=/src/target npm --prefix apps/web ci && npm --prefix apps/web run build
RUN --mount=type=cache,target=/usr/local/cargo/registry --mount=type=cache,target=/src/target cargo build --locked --release -p rxchef-server --features web-ui && install -Dm755 target/release/rxchef-server /out/web/rxchef-server
RUN --mount=type=cache,target=/usr/local/cargo/registry --mount=type=cache,target=/src/target cargo build --locked --release -p rxchef-server && install -Dm755 target/release/rxchef-server /out/headless/rxchef-server

FROM debian:bookworm-slim AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libssl3 curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY LICENSE /usr/share/doc/rxchef/LICENSE
USER 65532:65532
EXPOSE 8787
STOPSIGNAL SIGTERM
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s CMD curl --fail --silent http://127.0.0.1:8787/api/v1/health || exit 1
ENTRYPOINT ["/usr/local/bin/rxchef-server"]
CMD ["--listen", "127.0.0.1:8787"]

FROM runtime AS headless
COPY --from=build /out/headless/rxchef-server /usr/local/bin/rxchef-server

FROM runtime AS web
COPY --from=build /out/web/rxchef-server /usr/local/bin/rxchef-server
